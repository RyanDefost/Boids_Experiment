// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel MoveAgents

struct CrowdAgent
{
    float2 position;
    float2 velocity;
    float2 target;
    float2 gridPosition;
    float4 teamColor;
    float maxSpeed;
};

RWStructuredBuffer<CrowdAgent> agents;

int agentCount;
float deltaTime;

float _cohesionFactor;
float _alignmentFactor;
float _avoidanceFactor;

int _maxDistance;
int _minDistance;

float2 _outerBounds;

CrowdAgent agent;

void Logic()
{
    int neighbourCount = 0;
    float2 averageCenter = { 0, 0 };
    float2 averageDiraction = { 0, 0 };
    float2 avoidCenter = { 0, 0 };

    _maxDistance = 5;
    _minDistance = 1;
    
    for (int i = 0; i < agentCount; i++)
    {
        CrowdAgent otherAgent = agents[i];

        if (agent.gridPosition.x != otherAgent.gridPosition.x 
            || agent.gridPosition.y != otherAgent.gridPosition.y)
            continue;

        float currentDistance = distance(agent.position, otherAgent.position);
        
        if (currentDistance < _maxDistance)
        {
            //COHESION
            averageCenter += otherAgent.position;
            //ALIGNMNENT
            averageDiraction += otherAgent.velocity;

            neighbourCount++;
        }

        //SEPERATION
        if (currentDistance <= _minDistance)
            avoidCenter += agent.position - otherAgent.position;
    }

    if (neighbourCount > 0)
    {
        //COHESION
        averageCenter = averageCenter / neighbourCount;
        agent.velocity.x += (averageCenter.x - agent.position.x) * _cohesionFactor;
        agent.velocity.y += (averageCenter.y - agent.position.y) * _cohesionFactor;

        //ALIGNMENT
        averageDiraction = averageDiraction / neighbourCount;
        agent.velocity += (averageDiraction - agent.velocity) * _alignmentFactor;
    }

    //SEPERATION
    agent.velocity += avoidCenter * _avoidanceFactor;
}

void LimitSpeed()
{
    float2 velocity = agent.velocity;
    int _maxSpeed = 1;
    int _minSpeed = 1;
    
    float speed = sqrt(velocity.x * velocity.x + velocity.y * velocity.y);
    if (speed > _maxSpeed)
    {
        agent.velocity = (velocity / speed) * _maxSpeed;
    }
    else if (speed < _minSpeed)
    {
        agent.velocity = (velocity / speed) * _minSpeed;
    }
}

void CheckBounds()
{
    float2 position = agent.position;

    if (position.x < _outerBounds.x)
    {
        agent.velocity.x += 0.1f;
    }
    if (position.x > -_outerBounds.x)
    {
        agent.velocity.x -= 0.1f;
    }
    if (position.y < _outerBounds.y)
    {
        agent.velocity.y += 0.1f;
    }
    if (position.y > -_outerBounds.y)
    {
        agent.velocity.y -= 0.1f;
    }
}


[numthreads(256, 1, 1)]
void MoveAgents(uint3 id : SV_DispatchThreadID)
{
    int index = id.x;
    
    if (index >= agentCount) return;
    
    agent = agents[index];
    
    //
    Logic();
    LimitSpeed();
    CheckBounds();
    //
    
    agent.position += agent.velocity * 10 * deltaTime;
    
    agent.gridPosition = float2(
        floor(agent.position.x / 6),
        floor(agent.position.y / 6)
    );

    agents[index] = agent;
};

